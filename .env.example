# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password
DATABASE_NAME=eventlab_db

# JWT
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# VNPay Configuration
# Sandbox cho test: https://sandbox.vnpayment.vn/
VNPAY_TMN_CODE=YOUR_TMN_CODE
VNPAY_HASH_SECRET=YOUR_HASH_SECRET
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# VNPAY_RETURN_URL: URL callback sau khi thanh toán
# - Development với mobile app:
#   + Android Emulator: http://10.0.2.2:4000/payment/vnpay/callback
#   + iOS Simulator: http://localhost:4000/payment/vnpay/callback
#   + Real Device (cùng WiFi): http://192.168.x.x:4000/payment/vnpay/callback (thay bằng IP máy tính)
# - Production: https://your-domain.com/payment/vnpay/callback
VNPAY_RETURN_URL=http://10.0.2.2:4000/payment/vnpay/callback

# VNPAY_IPN_URL: URL webhook từ VNPay (phải public, không dùng localhost)
VNPAY_IPN_URL=https://your-domain.com/payment/vnpay/ipn

# MoMo Configuration (optional)
# MOMO_PARTNER_CODE=
# MOMO_ACCESS_KEY=
# MOMO_SECRET_KEY=
# MOMO_ENDPOINT=

# App Configuration
APP_PORT=4000
APP_URL=http://localhost:4000

# TypeORM — fresh DB setup (recommended):
# TYPEORM_SYNCHRONIZE=false   → tables created by InitialSchema migration
# TYPEORM_MIGRATIONS_RUN=true → runs InitialSchema then SeedsCommonData
# Dev-only entity auto-sync: TYPEORM_SYNCHRONIZE=true and TYPEORM_MIGRATIONS_RUN=false
TYPEORM_SYNCHRONIZE=false
TYPEORM_MIGRATIONS_RUN=true

# EventLab
APP_NAME=EventLab Admin
PUBLIC_INVITE_BASE_URL=http://localhost:3200
APP_SCHEME=eventlab

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
